{
  "name": "venomous-datasource",
  "version": "0.1.0",
  "description": "Unified multi-datasource connection SDK",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./bigquery": {
      "import": "./dist/bigquery/index.js",
      "types": "./dist/bigquery/index.d.ts"
    },
    "./s3": {
      "import": "./dist/s3/index.js",
      "types": "./dist/s3/index.d.ts"
    },
    "./gcs": {
      "import": "./dist/gcs/index.js",
      "types": "./dist/gcs/index.d.ts"
    },
    "./sheets": {
      "import": "./dist/sheets/index.js",
      "types": "./dist/sheets/index.d.ts"
    },
    "./azure-blob": {
      "import": "./dist/azure-blob/index.js",
      "types": "./dist/azure-blob/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\"",
    "build": "tsdown",
    "test": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "check:type": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run check:type"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/resource-manager": "^4.0.0",
    "@google-cloud/storage": "^7.14.0",
    "googleapis": "^171.0.0",
    "@azure/storage-blob": "^12.25.0",
    "@azure/identity": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/bigquery": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "@google-cloud/resource-manager": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "googleapis": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/resource-manager": "^4.0.0",
    "@google-cloud/storage": "^7.14.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "@azure/identity": "^4.6.0",
    "@azure/storage-blob": "^12.25.0",
    "googleapis": "^171.4.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.8.2"
}
