{
  "name": "venomous-datasource",
  "version": "0.1.0",
  "description": "Unified multi-datasource connection SDK",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./bigquery": {
      "import": "./dist/bigquery/index.js",
      "types": "./dist/bigquery/index.d.ts"
    },
    "./aws-s3": {
      "import": "./dist/aws-s3/index.js",
      "types": "./dist/aws-s3/index.d.ts"
    },
    "./google-cloud-storage": {
      "import": "./dist/google-cloud-storage/index.js",
      "types": "./dist/google-cloud-storage/index.d.ts"
    },
    "./google-sheets": {
      "import": "./dist/google-sheets/index.js",
      "types": "./dist/google-sheets/index.d.ts"
    },
    "./azure-blob-storage": {
      "import": "./dist/azure-blob-storage/index.js",
      "types": "./dist/azure-blob-storage/index.d.ts"
    },
    "./firestore": {
      "import": "./dist/firestore/index.js",
      "types": "./dist/firestore/index.d.ts"
    },
    "./mongodb": {
      "import": "./dist/mongodb/index.js",
      "types": "./dist/mongodb/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@azure/storage-blob": "^12.25.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/resource-manager": "^4.0.0",
    "@google-cloud/storage": "^7.14.0",
    "firebase-admin": "^13.0.0",
    "googleapis": "^171.0.0",
    "mongodb": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/bigquery": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@google-cloud/resource-manager": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "googleapis": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    }
  }
}
